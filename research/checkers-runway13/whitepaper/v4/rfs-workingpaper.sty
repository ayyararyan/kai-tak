% V4 adaptation: natbib's numeric-year parser misreads n.d.a/n.d.b as "n".
% Preserve correct disambiguating letters for undated institutional sources.
\let\RFSoriginalparsedate\NAT@parse@date
\def\NAT@parse@date#1#2#3#4#5#6@@{%
 \def\RFStestdate{#1#2#3#4}\def\RFSnodate{n.d.}%
 \ifx\RFStestdate\RFSnodate
  \def\NAT@year{n.d.}\def\NAT@exlab{{#5}}%
 \else\RFSoriginalparsedate#1#2#3#4#5#6@@\fi}
