{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ayyararyan/kai-tak/archive/schemas/provenance.schema.json",
  "type": "object",
  "required": [
    "schema_version",
    "edges",
    "activities"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "relation",
          "subject",
          "object",
          "evidence_level"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "relation": {
            "enum": [
              "attributed-to-source",
              "derived-from",
              "extracted-from",
              "generated-by",
              "frozen-snapshot-of",
              "depends-on-exact-version"
            ]
          },
          "subject": {
            "type": "string"
          },
          "object": {
            "type": "string"
          },
          "evidence_level": {
            "type": "string"
          }
        }
      }
    },
    "activities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "output_dataset",
          "input_datasets",
          "source_ids",
          "scripts",
          "evidence",
          "status",
          "limitation"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "output_dataset": {
            "type": "string"
          },
          "input_datasets": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "source_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "scripts": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "status": {
            "type": "string"
          },
          "limitation": {
            "type": "string"
          }
        }
      }
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "sha256"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "sha256": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    }
  }
}
