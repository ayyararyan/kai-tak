{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ayyararyan/kai-tak/archive/schemas/artifacts.schema.json",
  "type": "object",
  "required": [
    "schema_version",
    "archive_version",
    "artifacts"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "archive_version": {
      "const": "1.0.0"
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "path",
          "file_name",
          "extension",
          "bytes",
          "sha256",
          "collection_id",
          "dataset_ids",
          "source_ids",
          "creator",
          "acquisition_date",
          "generation_date",
          "observation_date",
          "publication_date",
          "source_revision_date",
          "locations",
          "existing_delivery",
          "existing_version",
          "processing_level",
          "rights_id",
          "publication_decision",
          "scientific_verification_status",
          "provenance_status",
          "derived_from",
          "required_for_reproducibility",
          "producer_scripts",
          "horizontal_crs",
          "vertical_datum",
          "limitations",
          "included_in_v1",
          "symlink"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^artifact-[a-f0-9]{20}$"
          },
          "path": {
            "type": "string"
          },
          "file_name": {
            "type": "string"
          },
          "extension": {
            "type": "string"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "collection_id": {
            "type": "string",
            "enum": [
              "01",
              "02",
              "03",
              "04",
              "05",
              "06",
              "07",
              "08",
              "09"
            ]
          },
          "dataset_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "source_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "creator": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "acquisition_date": {
            "type": [
              "string",
              "null"
            ]
          },
          "generation_date": {
            "type": [
              "string",
              "null"
            ]
          },
          "observation_date": {
            "type": [
              "string",
              "null"
            ]
          },
          "publication_date": {
            "type": [
              "string",
              "null"
            ]
          },
          "source_revision_date": {
            "type": [
              "string",
              "null"
            ]
          },
          "locations": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "location",
                "sha256",
                "bytes",
                "matches_canonical"
              ],
              "properties": {
                "location": {
                  "type": "string"
                },
                "sha256": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "bytes": {
                  "type": "integer",
                  "minimum": 0
                },
                "matches_canonical": {
                  "type": "boolean"
                }
              }
            }
          },
          "existing_delivery": {
            "type": [
              "string",
              "null"
            ]
          },
          "existing_version": {
            "type": [
              "string",
              "null"
            ]
          },
          "processing_level": {
            "type": "string"
          },
          "rights_id": {
            "type": "string"
          },
          "publication_decision": {
            "enum": [
              "Redistribution permitted",
              "Original authored material",
              "Link-only",
              "Permission required",
              "Rights unresolved",
              "Excluded"
            ]
          },
          "scientific_verification_status": {
            "type": "string"
          },
          "provenance_status": {
            "type": "string"
          },
          "derived_from": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "required_for_reproducibility": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "producer_scripts": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "horizontal_crs": {
            "type": [
              "string",
              "null"
            ]
          },
          "vertical_datum": {
            "type": [
              "string",
              "null"
            ]
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "included_in_v1": {
            "type": "boolean"
          },
          "symlink": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
