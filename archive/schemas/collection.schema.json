{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ayyararyan/kai-tak/archive/schemas/collection.schema.json",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "title",
    "dataset_ids",
    "citation",
    "file_count",
    "permitted_bundle_files",
    "release_manifest"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "id": {
      "type": "string",
      "enum": [
        "01",
        "02",
        "03",
        "04",
        "05",
        "06",
        "07",
        "08",
        "09"
      ]
    },
    "title": {
      "type": "string"
    },
    "dataset_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "citation": {
      "type": "string"
    },
    "file_count": {
      "type": "integer",
      "minimum": 0
    },
    "permitted_bundle_files": {
      "type": "integer",
      "minimum": 0
    },
    "release_manifest": {
      "type": "string"
    }
  }
}
