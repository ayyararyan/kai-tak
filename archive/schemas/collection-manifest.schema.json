{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ayyararyan/kai-tak/archive/schemas/collection-manifest.schema.json",
  "type": "object",
  "required": [
    "schema_version",
    "archive_version",
    "collection_id",
    "files"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "archive_version": {
      "const": "1.0.0"
    },
    "collection_id": {
      "type": "string",
      "enum": [
        "01",
        "02",
        "03",
        "04",
        "05",
        "06",
        "07",
        "08",
        "09"
      ]
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "bytes",
          "sha256",
          "artifact_id",
          "dataset_id",
          "rights_id",
          "publication_decision"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "artifact_id": {
            "type": "string"
          },
          "dataset_id": {
            "type": "string"
          },
          "rights_id": {
            "type": "string"
          },
          "publication_decision": {
            "const": "Redistribution permitted"
          }
        }
      }
    }
  }
}
